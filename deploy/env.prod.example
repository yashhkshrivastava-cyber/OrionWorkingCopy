# PRODUCTION .env template. Copy to C:\orion-prod\.env and fill in real values.
# Every secret here must differ from your dev .env.

ORION_ENV=production
ORION_SERVE_FRONTEND=1

# Separate DATABASE from dev, but the same ROLE: the app's SQL (schema.sql, grants.sql, migrate_bill.sql)
# hard-codes orion_user, so prod must use it too. Use the same password as the dev role
# (a role's password is cluster-wide; init_db_windows.ps1 resets it to ORION_DB_PASSWORD).
ORION_DB_HOST=localhost
ORION_DB_PORT=5432
ORION_DB_NAME=orion_prod
ORION_DB_USER=orion_user
ORION_DB_PASSWORD=
ORION_POSTGRES_SUPERUSER=postgres
ORION_POSTGRES_SUPER_PASSWORD=

# Long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"), at least 32 characters.
# The server refuses to start in production while the secrets below are empty or still the development/example values.
ORION_SESSION_SECRET=
ORION_ADMIN_USERNAME=
ORION_ADMIN_PASSWORD=
ORION_SESSION_TTL_DAYS=7
# The session cookie is marked Secure (never sent over plain HTTP) when the browser used HTTPS: auto (default), 1 (always; plain
# http:// addresses other than this PC's own stop working for sign-in) or 0 (never).
# ORION_COOKIE_SECURE=auto
# Other web origins allowed to call the API with a person's cookie. Leave unset: the app is served from this same address, which
# needs none. Exact origins only, comma separated, e.g. https://orion.example.ts.net
# ORION_CORS_ORIGINS=
# The browser security policy: enforce (default), report-only (log what it would block, block nothing) or off.
# ORION_CSP=enforce
# Logging: the console and data/logs/orion.log. ORION_LOG_LEVEL (INFO), ORION_SLOW_REQUEST_MS (2000: slower requests are warned
# about), ORION_LOG_DIR, ORION_LOG_FILE=0 (no file), ORION_ACCESS_LOG=0 (no per-request line).
# ORION_LOG_LEVEL=INFO
# Database connections kept open and lent to requests. Dev and prod share one PostgreSQL that allows 100, so keep this at 20 or lower.
# ORION_DB_POOL_MAX=20
# How long a request waits for a free connection before being answered "busy" (503).
# ORION_DB_POOL_TIMEOUT=15
# Refuse a bill or payment save that carries no one-time key (an out-of-date browser tab). Leave off for a week after a deploy.
# ORION_IDEMPOTENCY_REQUIRED=0

# One process serves UI + API on this port (dev uses 8000 / 5173)
ORION_API_PORT=8100
ORION_APP_URL=

ORION_SMTP_HOST=
ORION_SMTP_PORT=587
ORION_SMTP_USER=
ORION_SMTP_PASSWORD=
ORION_SMTP_FROM=
ORION_SMTP_TLS=1

# Real Tally company. Dev should point at a test company or leave TALLY blank.
ORION_TALLY_HOST=localhost
ORION_TALLY_PORT=9000
ORION_TALLY_COMPANY=
ORION_TALLY_FROM_DATE=
ORION_TALLY_TO_DATE=

# The Orion warehouse (the history of every record) loads itself when the data has changed, checking
# this often. 0 turns it off; the Refresh button on the warehouse page still works.
ORION_DW_AUTOLOAD_MINUTES=60

# Tenders: Orion checks the saved GeM tender searches this often (hours; 0 turns the schedule off, Check GeM now still works),
# and waits this long between requests to GeM (seconds, at least 1). GeM is a public site: keep the gap at 2 or more.
ORION_TENDERS_CHECK_HOURS=6
ORION_TENDERS_REQUEST_GAP_SECONDS=2
# How far back a check follows GeM's lists: bids published in this many days that are still open (7 to 365).
ORION_TENDERS_LOOKBACK_DAYS=90

# Calls in Messages: nothing is needed while everyone uses Orion over Tailscale or on one network (the two devices reach each other directly).
# For people outside it, name a STUN server (comma separated) and, if it is still not enough, a relay (TURN) with its login. Browsers also
# need the secure (https) address of Orion to use a microphone or camera.
# ORION_CALL_STUN_URLS=stun:stun.example.org:3478
# ORION_CALL_TURN_URLS=turn:turn.example.org:3478
# ORION_CALL_TURN_USER=
# ORION_CALL_TURN_PASSWORD=

# Encrypted database backups to Backblaze B2 (see docs/backup.md). Only the office PC holds the prod key.
ORION_BACKUP_ENABLED=1
ORION_BACKUP_BUCKET_ROLE=prod
ORION_BACKUP_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
ORION_BACKUP_S3_REGION=us-east-005
ORION_BACKUP_BUCKET=ProdPostgres
ORION_BACKUP_KEY_ID=
ORION_BACKUP_KEY=
ORION_BACKUP_AGE_RECIPIENTS=
ORION_BACKUP_DB_USER=orion_backup
ORION_BACKUP_DB_PASSWORD=
ORION_BACKUP_INTERVAL_HOURS=24
ORION_BACKUP_ALERT_EMAIL=

# The AI Copilot (see docs/ai-setup.md). It works with none of these set: Orion answers common questions itself.
# Nothing leaves this computer unless cloud AI is switched on here AND allowed by the organisation's policy (Settings > AI Copilot) AND by the person.
ORION_AI_ENABLED=1
# local_first (default) or local_only (cloud models are never used, whatever else is set)
ORION_AI_ROUTING_MODE=local_first
# A model on this computer, through Ollama (https://ollama.com): the default, and nothing is sent out. none turns it off.
ORION_AI_LOCAL_PROVIDER=ollama
ORION_AI_LOCAL_URL=http://127.0.0.1:11434
# e.g. qwen2.5:3b-instruct. Empty: the first model Ollama has.
ORION_AI_LOCAL_MODEL=
ORION_AI_LOCAL_CONTEXT=8192
ORION_AI_LOCAL_TIMEOUT=180
# Cloud AI: off. To use it: set ESCALATION=1, a provider, its key and a model, and a monthly budget (0 = no cloud spending at all).
ORION_AI_CLOUD_ESCALATION=0
ORION_AI_CLOUD_PROVIDER=none
OPENAI_API_KEY=
ORION_AI_OPENAI_MODEL=
ANTHROPIC_API_KEY=
ORION_AI_ANTHROPIC_MODEL=
ORION_AI_CLOUD_MONTHLY_BUDGET_USD=0
ORION_AI_CLOUD_USER_DAILY=20
# Limits per person.
ORION_AI_RATE_PER_MINUTE=10
ORION_AI_DAILY_REQUESTS=200
ORION_AI_DAILY_OUTPUT_TOKENS=200000
