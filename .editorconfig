# Editor settings, honoured by VS Code, JetBrains and most others. Line endings are left to git (core.autocrlf).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,sql,ps1,sh}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
